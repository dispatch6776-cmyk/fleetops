# ---------------------------------------------------------------------------
# FleetOps environment variables
# Copy to `.env.local` for local development, and add the same keys in
# Netlify → Site configuration → Environment variables for production.
#
# ⚠️  Only VITE_* variables are exposed to the browser. NEVER put the Supabase
#     service-role key or any private API secret in a VITE_* variable.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon"/publishable key — safe for the browser, protected by RLS.
VITE_SUPABASE_ANON_KEY=

# Google Maps JavaScript API key.
# Restrict it by HTTP referrer to your Netlify domain in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: public app URL used for password-reset redirects and share links.
VITE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Server-side only (Supabase Edge Functions / Netlify Functions).
# Set these as *secrets*; they are never bundled into the frontend.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
